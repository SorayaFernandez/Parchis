# Variables de Supabase para Parchís IA.
# Copia este archivo a .env.local (ignorado por Git) y pon los valores reales de tu proyecto:
# Supabase Dashboard → Project Settings → API Keys / Data API.
# En Vercel, configúralas en Project Settings → Environment Variables.

# URL del proyecto (pública).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave publicable (pública: llega al navegador; solo permite leer y Realtime por RLS).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EJEMPLO_no_es_una_clave_real

# Clave secreta: SOLO servidor. Nunca con prefijo NEXT_PUBLIC_ ni en el navegador.
SUPABASE_SECRET_KEY=sb_secret_EJEMPLO_no_es_una_clave_real

# ─── Límites de peticiones (Upstash Redis) ─────────────────────────────────────
# Sin estas dos variables el limitador queda DESACTIVADO (sin protección contra abusos).
# En desarrollo local no hacen falta. En Vercel: crea una base de datos Upstash Redis
# (Marketplace de Vercel → Upstash, o console.upstash.com) y añade sus credenciales REST.
# La integración del Marketplace puede crear KV_REST_API_URL / KV_REST_API_TOKEN: también sirven.
# UPSTASH_REDIS_REST_URL=https://tu-base-de-datos.upstash.io
# UPSTASH_REDIS_REST_TOKEN=EJEMPLO_no_es_un_token_real

# Opcional: cambiar los límites por defecto ("<peticiones>/<segundos>", ventana deslizante).
# RATE_LIMIT_CREATE=5/600          # POST /api/games, por IP
# RATE_LIMIT_ADVANCE_GAME=180/60   # POST /api/games/[id]/advance, por IP + partida
# RATE_LIMIT_ADVANCE_IP=600/60     # POST /api/games/[id]/advance, por IP en total
# RATE_LIMIT_READ=120/60           # GET /api/games/[id] y /partida/[id], por IP

# ─── Chat con LLM (fase 8.2b, Vercel AI Gateway) ───────────────────────────────
# DESACTIVADO salvo CHAT_LLM_ENABLED=true. Sin él (o con algún valor no válido), el chat usa solo
# las frases locales. SOLO servidor: nunca con el prefijo NEXT_PUBLIC_ (la app lo rechaza).
# En Vercel: Project Settings → Environment Variables.
# CHAT_LLM_ENABLED=false
# AI_GATEWAY_API_KEY=EJEMPLO_no_es_una_clave_real
# CHAT_LLM_MODEL=nvidia/nemotron-3.5-lightning-free   # debe estar en CHAT_LLM.allowedModels
# CHAT_LLM_PROVIDER=                                   # opcional: fija el proveedor (sin cambio automático)

# ─── Selector de movimientos con LLM (fase 8.3, Vercel AI Gateway) ─────────────
# Elige qué ficha mueve cada personaje cuando tiene dos o más jugadas legales; si falla, se usa la
# estrategia local (chooseMove). El motor sigue validando todas las jugadas.
# SOLO se activa en Vercel Preview: hace falta VERCEL=1 y VERCEL_ENV=preview (variables de sistema que
# pone Vercel; no hay que crearlas). En Production, Development o en local queda DESACTIVADO aunque
# estén estas variables. Independiente del chat: CHAT_LLM_ENABLED no lo activa ni al revés.
# SOLO servidor: nunca con el prefijo NEXT_PUBLIC_ (la app lo rechaza).
# Requisitos para que se active (todos):
#   1. MOVES_LLM_ENABLED=true
#   2. AI_GATEWAY_API_KEY: la misma clave que el chat (sección anterior); no hay una clave propia.
#   3. MOVES_LLM_MODEL con el identificador exacto de abajo (cualquier otro lo desactiva).
#   4. Upstash (UPSTASH_REDIS_REST_URL/UPSTASH_REDIS_REST_TOKEN de la sección de límites, o
#      KV_REST_API_URL/KV_REST_API_TOKEN): guarda el cupo de 20 consultas por partida. Sin Upstash no se
#      consulta al modelo. Ojo: con estas credenciales también se activan los límites de peticiones.
# Fijos en el código (no son variables): 3 s por consulta, sin reintentos, y 20 consultas por partida.
# MOVES_LLM_ENABLED=false
# MOVES_LLM_MODEL=nvidia/nemotron-3.5-lightning-free
# MOVES_LLM_PROVIDER=                                  # opcional: fija el proveedor (p. ej., nvidia)
